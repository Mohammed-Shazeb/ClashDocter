# ClashDoctor backend configuration.
# Copy this file to backend/.env and fill in a Qloo hackathon API key.
# backend/.env is gitignored — never commit a real key.
QLOO_API_KEY=

# Optional overrides (defaults shown)
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_TIMEOUT_SECONDS=30
# QLOO_INSIGHTS_TAKE=20
# PROFILE_CACHE_TTL_SECONDS=3600

# Optional: a language model for POST /api/plan/interpret. Any OpenAI-compatible
# /chat/completions endpoint that can answer with a JSON object. Leave both unset to
# use the built-in phrase rules — the API reports which path produced every plan.
# PLANNER_API_KEY=
# PLANNER_MODEL=
# PLANNER_BASE_URL=https://api.openai.com/v1
# PLANNER_TIMEOUT_SECONDS=20
